{
  "name": "ergou",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "doctor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "dev:services": "uv run --project apps/services ergou serve",
    "dev:web": "pnpm --filter @ergou/web dev",
    "dev:extension": "pnpm --filter @ergou/extension dev",
    "build": "pnpm --filter @ergou/web build && pnpm --filter @ergou/extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "uv run --project apps/services ruff check apps/services && pnpm exec prettier --check .",
    "test:services": "uv run --project apps/services pytest apps/services/tests -q",
    "test": "pnpm test:services && pnpm -r --if-present test",
    "test:e2e": "pnpm build && playwright test",
    "contracts": "uv run --project apps/services python -m ergou.export_schema && openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/api.ts",
    "contracts:check": "node scripts/contracts-check.mjs",
    "check": "pnpm contracts:check && pnpm typecheck && pnpm lint",
    "verify": "pnpm check && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0"
  }
}
